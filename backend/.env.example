# EduRAG Backend Configuration Example
APP_NAME=EduRAG
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security & Authentication
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL or SQLite)
DATABASE_URL=sqlite+aiosqlite:///./edurag.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/edurag

# LLM Provider Configuration (gemini, openai, groq, mistral, ollama, local)
LLM_PROVIDER=auto
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-1.5-flash
LLM_BASE_URL=https://api.groq.com/openai/v1

# RAG & Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_TYPE=chroma
CHROMA_PERSIST_DIR=./vectorstore

# RAG Retrieval Parameters
TOP_K=5
SIMILARITY_THRESHOLD=0.35
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# File Upload Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# CORS Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
